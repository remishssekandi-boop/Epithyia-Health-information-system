# Copy the project-root .env.example to the project root as .env,
# or configure these variables in your deployment environment.
PORT=3000
NODE_ENV=development

# Use "demo" to run with a local, persistent SQLite database instead of MySQL.
DATABASE_MODE=mysql
DEMO_DATABASE_FILE=backend/data/demo.sqlite
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=epithyia_health
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

JWT_SECRET=replace_with_at_least_32_random_characters_before_starting_auth
JWT_EXPIRES_IN=1h
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
COMMUNICATION_MODE=mock
SMS_API_KEY=your_africastalking_api_key
SMS_USERNAME=your_africastalking_username
SMS_SENDER_ID=your_approved_sender_id
USSD_CALLBACK_URL=https://your-public-domain.example/api/ussd/providers/africas-talking
PUBLIC_BASE_URL=https://your-public-domain.example
USSD_PROVIDER_TOKEN=
